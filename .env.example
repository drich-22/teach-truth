# Site URL (production canonical when custom domain is live)
# NEXT_PUBLIC_SITE_URL=https://teachtruth.org

# Optional webhook for Take the Wheel pledges
# ACTION_WEBHOOK_URL=

# Client review bubble (staging / Preview)
# Simple shared password for Ruth to leave page notes
NEXT_PUBLIC_REVIEW_PASSWORD=truth-review

# Comma-separated live hosts — bubble auto-hides here
NEXT_PUBLIC_LIVE_HOSTS=teachtruth.org,www.teachtruth.org

# Force review bubble on/off (optional)
# NEXT_PUBLIC_CLIENT_REVIEW=1
# NEXT_PUBLIC_CLIENT_REVIEW=0
